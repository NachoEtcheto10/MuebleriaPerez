# Copiá este archivo como .env.local para desarrollo, y cargá las mismas variables en Vercel
# (Project -> Settings -> Environment Variables).

# --- Solo servidor (funciones de /api). NUNCA les pongas el prefijo VITE_:
#     todo lo que empieza con VITE_ queda visible en el navegador.
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# --- Público (navegador): la URL de Neon Auth no es secreta.
VITE_NEON_AUTH_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"

# --- Solo para "npm run setup-neon" (crear los usuarios admin). No hace falta en Vercel.
ADMIN_PASSWORD=""
